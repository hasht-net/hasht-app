# fastlane drives the iOS half of the release. Android never touches it —
# Gradle plus the Play publisher API cover that, see .github/workflows/release.yaml.
#
# Two lanes, one per release kind:
#
#   beta      prerelease -> TestFlight, no submission
#   release   stable     -> App Store Connect, creates the version, does not
#                           submit for review (that stays a human decision)
#
# Neither lane mutates a tracked file. The version and build number arrive as
# xcargs build-setting overrides, which Info.plist already resolves through
# $(MARKETING_VERSION) / $(CURRENT_PROJECT_VERSION).

default_platform(:ios)

APP_ID = "net.hasht.app"
NSE_ID = "net.hasht.app.NotificationService"
SHARE_ID = "net.hasht.app.ShareExtension"
# Target => bundle id. The extension is signed with its own profile, and an
# archive with an unsigned or mis-signed extension fails at upload.
SIGNED_TARGETS = { "App" => APP_ID, "NotificationService" => NSE_ID, "ShareExtension" => SHARE_ID }.freeze
XCODEPROJ = "ios/App/App.xcodeproj"
OUTPUT_DIR = "build"

platform :ios do
  # Everything both lanes need: a temporary CI keychain, an ASC API key, and
  # the distribution cert + profile from the match repo. Returns the api_key
  # so the caller can hand it to the upload action.
  private_lane :prepare_signing do
    setup_ci if ENV["CI"]

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_API_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_API_KEY"),
      # The secret may hold either the raw .p8 or a base64 blob of it.
      is_key_content_base64: !ENV.fetch("ASC_API_KEY").strip.start_with?("-----"),
      duration: 1200,
      in_house: false,
    )

    if ENV["IOS_SIGNING_DIR"]
      import_certificate(
        certificate_path: File.join(ENV.fetch("IOS_SIGNING_DIR"), "distribution.p12"),
        certificate_password: ENV.fetch("IOS_DISTRIBUTION_PASSWORD"),
        keychain_name: ENV.fetch("MATCH_KEYCHAIN_NAME"),
        keychain_password: ENV.fetch("MATCH_KEYCHAIN_PASSWORD", ""),
      )
      { APP_ID => "app.mobileprovision", NSE_ID => "extension.mobileprovision", SHARE_ID => "share.mobileprovision" }.each do |bundle_id, filename|
        path = File.join(ENV.fetch("IOS_SIGNING_DIR"), filename)
        profile = FastlaneCore::ProvisioningProfile.parse(path)
        entitlements = profile.fetch("Entitlements")
        UI.user_error!("Wrong signing team") unless profile.fetch("TeamIdentifier").include?(ENV.fetch("APPLE_TEAM_ID"))
        UI.user_error!("Wrong profile for #{bundle_id}") unless entitlements.fetch("application-identifier") == "#{ENV.fetch('APPLE_TEAM_ID')}.#{bundle_id}"
        UI.user_error!("Missing shared App Group") unless entitlements.fetch("com.apple.security.application-groups", []).include?("group.net.hasht.app")
        UI.user_error!("Expired provisioning profile") unless profile.fetch("ExpirationDate").to_time > Time.now
        UI.user_error!("Development profile supplied") if entitlements["get-task-allow"]
        if bundle_id == APP_ID && entitlements["aps-environment"] != "production"
          UI.user_error!("App profile must enable production push notifications")
        end
        install_provisioning_profile(path: path)
        ENV["sigh_#{bundle_id}_appstore_profile-name"] = profile.fetch("Name")
      end
    else
      # Existing match setups remain supported; CI never writes to their repo.
      match(type: "appstore", app_identifier: SIGNED_TARGETS.values, readonly: true, api_key: api_key)
    end

    # The Capacitor-generated project ships CODE_SIGN_STYLE = Automatic, which
    # ignores the profile match just installed. Pin each target to its match
    # profile for the duration of this run.
    SIGNED_TARGETS.each do |target, bundle_id|
      update_code_signing_settings(
        use_automatic_signing: false,
        path: XCODEPROJ,
        targets: [target],
        team_id: ENV.fetch("APPLE_TEAM_ID"),
        bundle_identifier: bundle_id,
        code_sign_identity: "Apple Distribution",
        profile_name: ENV.fetch("sigh_#{bundle_id}_appstore_profile-name"),
      )
    end

    api_key
  end

  # The webview assets must already be in ios/App/App/public — `npm run sync`
  # locally, or the "Sync Capacitor" step in the workflow.
  private_lane :archive do
    build_app(
      project: XCODEPROJ,
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: SIGNED_TARGETS.values.to_h { |id| [id, ENV.fetch("sigh_#{id}_appstore_profile-name")] },
      },
      output_directory: OUTPUT_DIR,
      output_name: "Hasht.ipa",
      clean: true,
      xcargs: [
        "MARKETING_VERSION=#{ENV.fetch('VERSION_NUMBER')}",
        "CURRENT_PROJECT_VERSION=#{ENV.fetch('BUILD_NUMBER')}",
      ].join(" "),
    )
  end

  desc "Build and upload to TestFlight (prerelease)"
  lane :beta do
    api_key = prepare_signing
    archive
    upload_to_testflight(
      api_key: api_key,
      skip_submission: true,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "Build and upload to App Store Connect (stable)"
  lane :release do
    api_key = prepare_signing
    archive
    upload_to_app_store(
      api_key: api_key,
      # The store listing is maintained in App Store Connect, not this repo.
      skip_metadata: true,
      skip_screenshots: true,
      # Uploads the binary and creates the version; a human submits it.
      submit_for_review: false,
      precheck_include_in_app_purchases: false,
    )
  end
end
